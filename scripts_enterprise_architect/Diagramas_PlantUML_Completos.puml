newpage 2.4.3.7. CU15 - Secuencia: Medición Cartográfica
autonumber
actor "Consultor" as c
boundary "PanelHerramientas" as ph #E8F8F5
control "MeasurementEngine" as me #EBF5FB
boundary "LeafletMap" as map #E8F8F5

c -> ph: 1: clic 'Medir Distancia' o 'Medir Área'
activate ph
ph -> me: 2: activarModoMedicion(tipo)
activate me
me -> map: 3: cambiar cursor a Crosshair
activate map
loop Clics sucesivos en vértices
    c -> map: 4: clic en coordenadas
    map -> me: 5: map.click(latlng)
    me -> me: 6: calcularFormulaGeodesicaHaversine()
    me -> map: 7: trazar línea / polígono sombreado
