newpage 2.1.7.3. Arquitectura Modular del Sistema VisorDatosSIG 2026

package "«browser»\nCliente Web VisorDatosSIG\n(Consultores y Administradores)" as CWeb #D4EFDF {
    component [Leaflet.js 1.9 + Bootstrap 5] as Leaflet
    component [Interfaz Cartográfica & HUD Coordenadas] as WebUI
    component [Módulos JS: Map, Layers, Measure, Search] as JSModules
}

package "Backend Principal VisorDatosSIG\n(ASP.NET Core 8 Web API & MVC)" as CBackend #D6EAF8 {
    component [Kestrel / Reverse Proxy HTTPS (Puerto 5000)] as Gateway
    component [Controladores: Capas, Agua, Admin, Busqueda] as Controllers
    component [Autenticación PBKDF2-HMAC-SHA512 + PBAC] as Auth
    component [Módulos Negocio: Catastro, Red Vial, Cortes y Reconexiones] as Negocio
    component [DijkstraRoutingService (Rutas sobre Grafo Red de Calles)] as Dijkstra
    component [Dapper ORM & Spatial Repositories] as Dapper
    database "Microsoft SQL Server 2022 Spatial\n(GEOMETRY WGS 84 SRID 4326)" as SqlDb #FADBD8
}

package "«device»\nApp Móvil Cuadrillas\n(Flutter / Dart)" as CMovil #FCF3CF {
    component [Flutter UI (TaskList, RouteMap, FieldRecord)] as FlutterUI
    component [Módulo GPS & Telemetría en Tiempo Real] as GPSMovil
    component [Cámara y Captura de Evidencias de Medidor] as CameraMovil
}

package "Suite Escritorio ETL\n(VisorDatosSIG.Migrador WinForms)" as CDesktop #E8DAEF {
    component [Parser Binario ESRI (.shp/.shx/.dbf/.prj)] as Parser
    component [Validador Criptográfico WGS 84 (SRID 4326)] as Validator
    component [Motor Transaccional por Lotes (Batch Insert + Rollback)] as Batch
}

package "Servidores Base Cartográficos (Nube)" as CCloud #E5E7E9 {
    component [OpenStreetMap (Tile Server)] as OSM
    component [Carto Positron / Carto Dark (CDN)] as Carto
    component [Esri World Imagery (Satelital)] as Esri
}

package "Almacenamiento y Auditoría" as CStorage #E8F8F5 {
    component [Repositorio de Fotos de Medidores] as FotoStorage
    component [Bitácora de Auditoría Inmutable] as AuditStorage
}

CWeb --> Gateway : HTTPS REST / GeoJSON RFC 7946
CMovil --> Gateway : REST API JSON / HTTP 2.0 (Telemetría)
CDesktop --> SqlDb : TDS / TCP-IP 1433 (Transaccional Batch)
Gateway --> Controllers
Controllers --> Negocio
Negocio --> Dijkstra
Negocio --> Dapper
Dapper --> SqlDb : SQL Spatial (STIntersects, Filter)
CWeb --> CCloud : HTTP/S Tile Request XYZ
CMovil --> FotoStorage : Carga de evidencias fotográficas
Controllers --> AuditStorage : Registro continuo de eventos

