newpage 2.4.3.1. CU01 - Secuencia: Gestión de Sesión y Autenticación
autonumber
actor "Usuario" as u
boundary "LoginView" as lv #E8F8F5
control "AutenticacionController" as ac #EBF5FB
control "UsuarioService" as us #EBF5FB
entity "Usuario" as ent #FEF9E7

alt Iniciar Sesión con Credenciales Válidas
    u -> lv: 1: ingresarCredenciales(user, pass)
    activate lv
    lv -> ac: 2: POST /api/autenticacion/login
    activate ac
    ac -> us: 3: autenticarAsync(user, pass)
    activate us
    us -> ent: 4: buscarPorUsername(user)
    activate ent
    ent --> us: 5: confirmacion(hash, salt, rol)
    deactivate ent
    us -> us: 6: verificarPBKDF2(pass, salt)
    us --> ac: 7: tokenValido(ClaimsPrincipal)
    deactivate us
    ac --> lv: 8: emitirCookie(HttpOnly)
    deactivate ac
    lv --> u: 9: redireccionar a /Home/Index
    deactivate lv
else Credenciales Inválidas o Bloqueo
    u -> lv: 10: ingresarCredenciales(user, pass_invalido)
    activate lv
    lv -> ac: 11: POST /api/autenticacion/login
    activate ac
    ac -> us: 12: autenticarAsync(user, pass_invalido)
    activate us
    us --> ac: 13: errorAutenticacion('Credenciales no válidas')
    deactivate us
    ac --> lv: 14: 401 Unauthorized
    deactivate ac
    lv --> u: 15: mostrarAlertaError('Usuario o clave incorrecta')
    deactivate lv
end

newpage 2.4.3.2. CU06 - Secuencia: Validación WGS 84 (SRID 4326)
autonumber
actor "OperadorMigrador" as op
boundary "MainMigradorForm" as frm #E8F8F5
control "MigradorService" as ms #EBF5FB
control "ShapefileReader" as sr #EBF5FB
entity "PrjSpatialReference" as prj #FEF9E7

alt Proyección Cartográfica Válida (WGS 84)
    op -> frm: 1: pulsar 'Validar Proyección y CRS'
    activate frm
    frm -> ms: 2: validarArchivoShapefileAsync(rutaShp)
    activate ms
    ms -> sr: 3: inspeccionarPrj(rutaPrj)
    activate sr
    sr -> prj: 4: parsearWKT_PRJ()
    activate prj
    prj --> sr: 5: confirmacion(EsWGS84=true, SRID=4326)
    deactivate prj
    sr --> ms: 6: resultado(Aprobado)
    deactivate sr
    ms --> frm: 7: validacionShapefileDto(Aprobado)
    deactivate ms
    frm --> op: 8: mostrar badge verde 'WGS 84 Válido'
    deactivate frm
else Proyección No Estándar (UTM o Sin PRJ)
    op -> frm: 9: pulsar 'Validar Proyección'
    activate frm
    frm -> ms: 10: validarArchivoShapefileAsync(ruta)
    activate ms
    ms --> frm: 11: error('CRS no válido: Requiere EPSG:4326')
    deactivate ms
    frm --> op: 12: bloquear botón 'Iniciar Migración'
    deactivate frm
end

newpage 2.4.3.3. CU08 - Secuencia: Migración Masiva Transaccional
autonumber
actor "OperadorMigrador" as op
boundary "MainMigradorForm" as frm #E8F8F5
control "MigradorService" as ms #EBF5FB
control "BatchProcessor" as bp #EBF5FB
entity "SqlTransaction" as tx #FEF9E7

op -> frm: 1: clic 'Iniciar Migración Masiva'
activate frm
frm -> ms: 2: migrarCapaAsync(opciones, IProgress)
activate ms
ms -> tx: 3: BEGIN TRANSACTION
activate tx
loop Por cada lote de 1000 entidades espaciales
    ms -> bp: 4: insertarLote(batch, SRID=4326)
    activate bp
    bp -> tx: 5: BulkInsert STGeomFromText() con STIsValid() = 1
    bp --> ms: 6: confirmacion(insertados, tiempoMs)
    deactivate bp
    ms --> frm: 7: reportarProgreso(porcentaje, stats)
end
ms -> tx: 8: COMMIT TRANSACTION
deactivate tx
ms --> frm: 9: resumenMigracionDto(Exitoso)
deactivate ms
frm --> op: 10: desplegar cuadro de estadísticas finales
deactivate frm

newpage 2.4.3.4. CU11 - Secuencia: Carga de Visor y GeoJSON BBox
autonumber
actor "Consultor" as c
boundary "LeafletMap" as map #E8F8F5
control "CapasApiController" as api #EBF5FB
control "CapaService" as cs #EBF5FB
entity "LotePredio" as ent #FEF9E7

c -> map: 1: pan / zoom en el territorio
activate map
map -> api: 2: GET /api/capas/geojson?capa=Lotes&bbox=minX,minY,maxX,maxY
activate api
api -> cs: 3: obtenerGeoJsonBBoxAsync(capa, bbox)
activate cs
cs -> ent: 4: SELECT WHERE Geometria.Filter(bbox) = 1
activate ent
ent --> cs: 5: SqlDataReader (WKT / Atributos)
deactivate ent
cs -> cs: 6: serializar FeatureCollection (Gzip)
cs --> api: 7: 200 OK (Content-Encoding: gzip)
deactivate cs
api --> map: 8: respuesta GeoJSON RFC 7946
deactivate api
map -> map: 9: L.geoJSON().addTo(map)
map --> c: 10: renderizado vectorial con estilos y simbología
deactivate map

newpage 2.4.3.5. CU13 - Secuencia: Identificación por Clic / Toque
autonumber
