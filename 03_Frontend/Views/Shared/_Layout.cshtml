@using System.Security.Claims
@{
    var isAuth = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole("Administrador");
    var isConsultor = User.IsInRole("Consultor");
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var isLoginPage = currentAction == "Login" && currentController == "Home";
    var username = User.Identity?.Name ?? "Usuario";
    var fullName = User.FindFirst(ClaimTypes.GivenName)?.Value ?? username;
    var userEmail = User.FindFirst(ClaimTypes.Email)?.Value ?? "";
}
<!DOCTYPE html>
<html lang="es" data-bs-theme="dark" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"] - VisorDatosSIG</title>
    <meta name="description" content="Sistema de Información Geográfica Profesional VisorDatosSIG 2026. Visualización de capas catastrales, prediales y viales en WGS84." />

    <!-- Script de Inicialización Rápida de Tema (Evita parpadeo de color) -->
    <script>
        (function () {
            try {
                const saved = localStorage.getItem('sig_theme') || 'dark';
                document.documentElement.setAttribute('data-bs-theme', saved);
                document.documentElement.setAttribute('data-theme', saved);
            } catch (e) { }
        })();
    </script>

    <!-- Favicon / Logo en pestaña -->
    <link rel="icon" type="image/jpeg" href="~/src/logo.jpg" asp-append-version="true" />
    <link rel="shortcut icon" type="image/jpeg" href="~/src/logo.jpg" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/src/logo.jpg" asp-append-version="true" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=Kalam:wght@400;700&family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="sig-app-body @(isLoginPage ? "sig-login-body" : "")">
    @if (!isLoginPage)
    {
        <!-- Navbar Superior -->
        <header class="sig-navbar-header">
            <nav class="navbar navbar-expand-lg sig-navbar">
                <div class="container-fluid px-2 px-sm-3">
                    <!-- Brand / Logo -->
                    <a class="navbar-brand d-flex align-items-center gap-2 me-1 me-sm-3" asp-controller="Home" asp-action="@(isAuth ? "Index" : "Login")">
                        <img src="~/src/logo.jpg" alt="Logo VisorDatosSIG" class="sig-brand-logo-img flex-shrink-0" asp-append-version="true" />
                        <div class="sig-brand-text-container">
                            <div class="sig-brand-title">VisorDatosSIG <span class="sig-badge-year d-none d-sm-inline">2026</span></div>
                            <div class="sig-brand-subtitle d-none d-md-block">Catastro Urbano & Red Vial Espacial (SRID 4326)</div>
                        </div>
                    </a>

                    @if (isAuth)
                    {
                        <!-- Acciones Centrales / Búsqueda Rápida en Navbar (Desktop) -->
                        <div class="d-none d-xl-flex align-items-center flex-grow-1 max-w-500 mx-4">
                            <div class="input-group sig-nav-search">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input type="text" id="navQuickSearchInput" class="form-control" placeholder="Búsqueda rápida por código, titular o calle..." autocomplete="off">
                                <button class="btn btn-primary" type="button" id="btnNavQuickSearch">Buscar</button>
                            </div>
                        </div>

                        <!-- Menú Usuario, Navegación y Switch de Tema -->
                        <div class="d-flex align-items-center gap-1 gap-sm-2 ms-auto">
                            <!-- Enlace Principal: Visor Cartográfico -->
                            <a asp-controller="Home" asp-action="Index" class="btn btn-sig-nav d-none d-sm-inline-flex @(currentAction == "Index" && currentController == "Home" ? "active" : "")" title="Visor Cartográfico">
                                <i class="bi bi-map-fill me-1"></i> <span class="d-none d-md-inline">Visor Cartográfico</span>
                            </a>

                            <!-- Botón Modo Oscuro / Modo Claro (Justo al lado de Visor Cartográfico) -->
                            <button class="btn btn-sig-nav btn-sig-theme-toggle d-flex align-items-center gap-1.5 px-2 px-md-3" id="btnThemeToggle" type="button" title="Alternar entre modo oscuro y modo claro" aria-label="Cambiar tema">
                                <i class="bi bi-moon-stars-fill text-warning fs-6" id="themeIcon"></i>
                                <span class="d-none d-md-inline fw-medium" id="themeLabel">Modo Oscuro</span>
                            </button>

                            <!-- Dropdown de Administración (EXCLUSIVO PARA ADMINISTRADORES) -->
                            @if (isAdmin)
                            {
                                <div class="dropdown" id="adminNavDropdown">
                                    <button class="btn btn-sig-nav dropdown-toggle @(currentController == "Admin" ? "active" : "")" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Módulos de Administración">
                                        <i class="bi bi-shield-lock-fill text-warning me-1"></i> <span class="d-none d-md-inline">Administración</span>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end sig-dropdown-menu shadow-lg">
                                        <li><h6 class="dropdown-header text-warning small"><i class="bi bi-gear-fill me-1"></i>Módulos de Administrador</h6></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Migraciones"><i class="bi bi-cloud-arrow-up-fill me-2 text-primary"></i>Historial de Migraciones</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Auditoria"><i class="bi bi-journal-text me-2 text-info"></i>Bitácora de Auditoría</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Usuarios"><i class="bi bi-people-fill me-2 text-success"></i>Gestión de Usuarios</a></li>
                                    </ul>
                                </div>
                            }

                            <!-- Menú Perfil de Usuario con Rol Distintivo -->
                            <div id="userAuthContainer">
                                <div class="dropdown">
                                    <button class="btn btn-sig-nav dropdown-toggle d-flex align-items-center gap-1 gap-sm-2 px-2 px-sm-3" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-person-circle text-accent fs-5"></i>
                                        <span class="fw-semibold sig-user-name d-none d-sm-inline">@username</span>
                                        @if (isAdmin)
                                        {
                                            <span class="badge bg-warning text-dark sig-role-badge d-none d-sm-inline-block"><i class="bi bi-shield-fill me-1"></i>Admin</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info text-dark sig-role-badge d-none d-sm-inline-block"><i class="bi bi-eye-fill me-1"></i>Consultor</span>
                                        }
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end sig-dropdown-menu shadow-lg">
                                        <li class="px-3 py-2 border-bottom sig-dropdown-user-header">
                                            <div class="fw-bold sig-user-fullname">@fullName</div>
                                            <small class="text-muted d-block text-truncate" style="max-width: 200px;">@userEmail</small>
                                            <div class="mt-1">
                                                @if (isAdmin)
                                                {
                                                    <span class="badge bg-warning text-dark"><i class="bi bi-shield-check me-1"></i>Administrador</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-info text-dark"><i class="bi bi-search me-1"></i>Consultor</span>
                                                }
                                            </div>
                                        </li>
                                        <li>
                                            <button type="button" class="dropdown-item py-2 d-flex align-items-center justify-content-between" onclick="ThemeService.toggleTheme()">
                                                <span><i class="bi bi-circle-half me-2 text-info"></i>Alternar Tema</span>
                                                <span class="badge bg-secondary-subtle text-secondary border small" id="dropdownThemeBadge">Auto</span>
                                            </button>
                                        </li>
                                        <li><hr class="dropdown-divider my-1"></li>
                                        <li>
                                            <a class="dropdown-item text-danger py-2" asp-controller="Home" asp-action="Logout">
                                                <i class="bi bi-box-arrow-right me-2"></i><strong>Cerrar Sesión</strong>
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-1 gap-sm-2 ms-auto">
                            <!-- Theme switcher para acceso público -->
                            <button class="btn btn-sig-theme-toggle" id="btnThemeToggle" type="button" title="Cambiar modo oscuro / claro" aria-label="Cambiar tema">
                                <i class="bi bi-moon-stars-fill text-info" id="themeIcon"></i>
                            </button>
                            <a asp-controller="Home" asp-action="Login" class="btn btn-sig-login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                            </a>
                        </div>
                    }
                </div>
            </nav>
        </header>
    }

    <!-- Contenido Principal -->
    <main role="main" class="sig-main-content @(isLoginPage ? "sig-login-main" : "")">
        @RenderBody()
    </main>

    <!-- Contenedor de Toasts / Notificaciones -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 2000;" id="toastContainer"></div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="~/js/auth.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
