@{
    ViewData["Title"] = "Acceso Denegado - VisorDatosSIG";
}

<div class="container py-5">
    <div class="row justify-content-center align-items-center min-vh-70">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card sig-card-access-denied shadow-2xl border-0 text-center p-4 p-md-5">
                <div class="sig-denied-icon-wrapper mx-auto mb-3">
                    <i class="bi bi-shield-x display-4 text-warning"></i>
                </div>
                <h3 class="fw-bold text-white mb-2">Acceso Restringido</h3>
                <p class="text-muted mb-4">
                    Su perfil actual (<span class="text-info fw-semibold">@(User.IsInRole("Consultor") ? "Consultor" : "Sin privilegios administrativos")</span>) no cuenta con autorización para acceder a este módulo del sistema.
                </p>

                <div class="p-3 bg-dark-subtle rounded-3 text-start mb-4 small text-light border border-secondary border-opacity-25">
                    <div class="fw-semibold text-warning mb-1">
                        <i class="bi bi-info-circle-fill me-1"></i> Políticas de Control de Acceso:
                    </div>
                    <ul class="mb-0 ps-3 text-muted">
                        <li>Los módulos de <strong>Migraciones Shapefile</strong>, <strong>Bitácora de Auditoría</strong> y <strong>Gestión de Usuarios</strong> están reservados exclusivamente para el rol <strong>Administrador</strong>.</li>
                        <li>Como <strong>Consultor</strong>, usted tiene acceso completo al <strong>Visor Cartográfico</strong>, capas espaciales, búsquedas, fichas técnicas y herramientas de medición.</li>
                    </ul>
                </div>

                <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2 fw-semibold">
                        <i class="bi bi-map-fill me-2"></i>Volver al Visor Cartográfico
                    </a>
                    <a asp-controller="Home" asp-action="Logout" class="btn btn-outline-secondary px-4 py-2">
                        <i class="bi bi-box-arrow-right me-2"></i>Cambiar de Usuario
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
